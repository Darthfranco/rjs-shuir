{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      },
      {
        "src": "*.html",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/upload-recording",
        "dest": "/server.js",
        "methods": ["POST"]
      },
      {
        "src": "/(send-support|search|store-recording)",
        "dest": "/server.js"
      },
      {
        "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|ico|svg|mp3))",
        "dest": "/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }