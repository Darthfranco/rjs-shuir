{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      },
      {
        "src": "*.html",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/health",
        "dest": "/server.js",
        "methods": ["GET"]
      },
      {
        "src": "/generate-upload-url",
        "dest": "/server.js",
        "methods": ["POST", "OPTIONS"]
      },
      {
        "src": "/store-recording",
        "dest": "/server.js",
        "methods": ["POST", "OPTIONS"]
      },
      {
        "src": "/send-support",
        "dest": "/server.js",
        "methods": ["POST", "OPTIONS"]
      },
      {
        "src": "/search",
        "dest": "/server.js",
        "methods": ["GET"]
      },
      {
        "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|ico|svg|mp3))",
        "dest": "/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "env": {
      "MONGODB_URI": "@mongodb_uri",
      "BLOB_READ_WRITE_TOKEN": "@blob_read_write_token",
      "EMAIL_USER": "@email_user",
      "EMAIL_PASS": "@email_pass"
    }
  }